# 2nd Act Capital — environment variables (no values committed)
# Copy the relevant section into apps/web/.env.local or your API host config.

# --- Web (apps/web) — Auth0 Next.js SDK ---
APP_BASE_URL=
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
# Base URL of the FastAPI backend (used by the web app)
NEXT_PUBLIC_API_URL=
# Auth0 API audience the web app requests an access token for
AUTH0_AUDIENCE=

# --- Web (apps/web) — SECOND, SEPARATE Auth0 tenant: Hollisworks platform staff.
# Used ONLY for admin.hollisworks.com. Leave unset to keep the app single-tenant
# (every host uses the 2nd Act config above, unchanged).
HOLLISWORKS_AUTH0_DOMAIN=
HOLLISWORKS_AUTH0_CLIENT_ID=
HOLLISWORKS_AUTH0_CLIENT_SECRET=
# Cookie-encryption secret for the admin session; falls back to AUTH0_SECRET.
HOLLISWORKS_AUTH0_SECRET=
# API audience the staff access token is minted for (defaults to the platform API).
HOLLISWORKS_AUTH0_AUDIENCE=

# --- API (apps/api) ---
DATABASE_URL=
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
# SECOND, SEPARATE Auth0 tenant validation (Hollisworks staff). Leave the domain
# unset to keep token validation single-tenant (2nd Act only), unchanged.
HOLLISWORKS_AUTH0_DOMAIN=
HOLLISWORKS_AUTH0_AUDIENCE=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
ANTHROPIC_API_KEY=
